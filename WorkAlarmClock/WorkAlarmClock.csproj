<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WorkAlarmClock</RootNamespace>
    <AssemblyName>WorkAlarmClock</AssemblyName>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <ApplicationIcon>Assets\iconfinder-info-4341298_120528.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WPF + WinForms 混用时 Application / MessageBox / Point / Brush 等类型存在二义。
       此处移除 WinForms 与 System.Drawing 的隐式 using，相关类型一律以别名引用
       （using WF = System.Windows.Forms; using SD = System.Drawing;），见架构文档 D-11。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 基础依赖仅使用微软官方轻量包；ZXing.Net 为二维码/条码编解码功能的专项依赖。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- 运行时资源：桌宠立绘（R-58）+ 托盘图标正常/灰度两版（R-59）。 -->
  <ItemGroup>
    <Resource Include="Assets\pet.png" />
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray-gray.ico" />
  </ItemGroup>

</Project>
