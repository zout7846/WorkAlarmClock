<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WorkAlarmClock</RootNamespace>
    <AssemblyName>WorkAlarmClock</AssemblyName>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <ApplicationIcon>Assets\iconfinder-info-4341298_120528.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WPF + WinForms 混用时 Application / MessageBox / Point / Brush 等类型存在二义。
       此处移除 WinForms 与 System.Drawing 的隐式 using，相关类型一律以别名引用
       （using WF = System.Windows.Forms; using SD = System.Drawing;），见架构文档 D-11。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 仅允许两个微软官方轻量包（增量 R-29）：SQLite 持久化与正式 IOC 容器。
       禁止任何社区第三方包（不引入 CommunityToolkit.Mvvm / MahApps / Hardcodet.NotifyIcon 等）。
       自写 MVVM 基类、P/Invoke 锁屏/空闲检测、WinForms NotifyIcon 维持不变。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <!-- 运行时资源：桌宠立绘（R-58）+ 托盘图标正常/灰度两版（R-59）。 -->
  <ItemGroup>
    <Resource Include="Assets\pet.png" />
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray-gray.ico" />
  </ItemGroup>

</Project>
