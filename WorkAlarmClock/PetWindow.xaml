<Window x:Class="WorkAlarmClock.PetWindow"
        x:Name="PetRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkAlarmClock.Views"
        Title="WorkAlarmClock 桌宠"
        SizeToContent="WidthAndHeight"
        MinWidth="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        FontFamily="Microsoft YaHei UI"
        Opacity="{Binding PetOpacity}"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        MouseDoubleClick="OnWindowMouseDoubleClick"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开主面板" Command="{Binding OpenMainPanelCommand}" />
            <MenuItem x:Name="IslandMenuItem" Header="收起为灵动岛" Click="OnToggleIslandClick" />
            <MenuItem Header="隐藏桌宠" Click="OnHidePetClick" />
            <Separator />
            <MenuItem Header="开始工作" Command="{Binding StartWorkCommand}" />
            <MenuItem Header="开始休息" Command="{Binding StartRestCommand}" />
            <MenuItem Header="结束当天" Command="{Binding EndDayCommand}" />
            <Separator />
            <MenuItem Header="开始/停止专注" Command="{Binding FocusToggleCommand}" />
            <MenuItem Header="生成工作汇报" Command="{Binding GenerateReportCommand}" />
            <MenuItem Header="区域截图" Command="{Binding ScreenshotCommand}" />
            <MenuItem Header="工作统计" Command="{Binding OpenStatisticsCommand}" />
            <MenuItem Header="历史日报" Command="{Binding OpenHistoryCommand}" />
            <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="退出" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.9">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="HoverLift" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 收起态：灵动岛（连续曲率圆角，固定屏幕顶部居中） -->
        <Grid x:Name="IslandHost"
              Width="176" Height="38"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="Collapsed"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 连续曲率（超椭圆）底形，Data 由代码按尺寸生成 -->
            <Path x:Name="IslandShape" Fill="#F70B0B0E" Stroke="#26FFFFFF" StrokeThickness="1" />

            <Grid x:Name="IslandContent" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态文字（替代原状态点），左侧是跟随状态色的圆形脉冲光晕 -->
                <Grid x:Name="IslandStateCell" Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="IslandGlow" Width="24" Height="24"
                                 Fill="{Binding StateGlowBrush}"
                                 VerticalAlignment="Center"
                                 Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="IslandGlowScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="5,0,0,0"
                                   Foreground="{Binding StateDotBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                           FontFamily="Segoe UI Semibold" Foreground="#FFF6F8FB" />

                <!-- 活动状态 + 触发它的程序（活动结束后延迟 3 秒消失） -->
                <Grid x:Name="IslandActivityCell" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="IslandActivityText" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{Binding IslandActivityBrush}"
                               Text="{Binding IslandActivityText}"
                               Visibility="{Binding IslandActivityVisible, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 通知弹出文本 -->
                <TextBlock x:Name="IslandNotifyText" Grid.Column="3" Margin="9,0,0,0"
                           VerticalAlignment="Center" FontSize="11.5" MaxWidth="190"
                           TextTrimming="CharacterEllipsis" Foreground="#FFEDF2F8" Opacity="0" />

                <!-- 悬停展开的监控信息 -->
                <Border x:Name="IslandExtraWrap" Grid.Column="4" Opacity="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="13" Margin="11,0" Background="#33FFFFFF"
                                VerticalAlignment="Center" />
                        <TextBlock Text="已工作" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="#FF98A4B4" />
                        <TextBlock Text="{Binding WorkDurationText}" Margin="4,0,0,0" FontSize="10.5"
                                   FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFE9EFF8" />

                        <Border Width="1" Height="13" Margin="11,0" Background="#33FFFFFF"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IslandTaskText}" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="#FFB9C6D6" />

                        <StackPanel x:Name="IslandFocus" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocusChipVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="1" Height="13" Margin="11,0" Background="#33FFFFFF"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="#FFFF8A7A" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FocusChipText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FFFF8A7A" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 展开态 -->
        <StackPanel x:Name="PetBody"
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,6,10,14">

            <!-- 时钟卡（对话合入卡内，取代独立气泡） -->
            <Border Width="152" CornerRadius="18" Padding="12,9"
                    HorizontalAlignment="Center"
                    BorderBrush="#FFE4ECF8" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="#FDFFFFFF" Offset="0" />
                        <GradientStop Color="#F4F1F7FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.22" Color="#FF2B4A7A" />
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding TimeText}"
                               FontSize="26" FontWeight="Bold"
                               FontFamily="Segoe UI Semibold"
                               Foreground="#FF16202B" />
                    <Border CornerRadius="8" Padding="7,3"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFE9F2FF" Offset="0" />
                                <GradientStop Color="#FFDDE9FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource BrushAccentDeep}">
                            <Run Text="已工作" />
                            <Run Text="{Binding WorkDurationText, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Border>

                    <!-- 对话（BubbleVisible 时在卡内展开） -->
                    <StackPanel x:Name="BubblePanel" Margin="0,7,0,0" MaxWidth="128">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BubbleVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                     Duration="0:0:0.22" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Height="1" Background="#FFE9F0F9" Margin="0,0,0,6" />

                        <TextBlock Text="{Binding BubbleText}"
                                   FontSize="11.5"
                                   LineHeight="16"
                                   TextWrapping="Wrap"
                                   Foreground="#FF3C4A59" />

                        <ItemsControl ItemsSource="{Binding BubbleActions}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Margin="0,0,5,0"
                                            Padding="8,2"
                                            FontSize="10.5"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="0" Height="23"
                                            Command="{Binding DataContext.BubbleActionCommand, ElementName=PetRoot}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding BubbleActionLabel}"
                                Margin="0,6,0,0"
                                FontSize="10.5"
                                HorizontalAlignment="Left"
                                MinWidth="0" Height="23" Padding="9,0"
                                Command="{Binding DataContext.BubbleActionCommand, ElementName=PetRoot}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BubbleActionLabel}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 番茄钟倒计时胶囊（仅在计时中显示） -->
            <Border CornerRadius="9" Padding="9,3" HorizontalAlignment="Center" Margin="0,7,0,0"
                    Background="#FFFFF2F0" BorderBrush="#FFFFDAD4" BorderThickness="1"
                    Visibility="{Binding IsFocusChipVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="#FFE0503F" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FocusChipText}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#FFE0503F" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 卡通角色 -->
            <views:PetAvatarControl x:Name="PetAvatar"
                                    Width="150" Height="215"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Left"
                                    CurrentState="{Binding CurrentState}"
                                    RestSourceValue="{Binding CurrentRestSource}"
                                    ReminderOverlay="{Binding ReminderOverlay}"
                                    Species="{Binding Species}"
                                    FurGradient="{Binding FurGradient}"
                                    FurSolid="{Binding FurSolid}"
                                    FurLight="{Binding FurLight}"
                                    FurOutline="{Binding FurOutline}"
                                    EarInner="{Binding EarInner}"
                                    Blush="{Binding Blush}"
                                    NoseColor="{Binding NoseColor}" />

            <!-- 状态胶囊 + 亲密度等级 -->
            <StackPanel Orientation="Horizontal" Margin="0,-2,0,0" HorizontalAlignment="Center">
                <Border CornerRadius="10" Padding="8,3.5"
                        Background="#F7FFFFFF" BorderBrush="#FFE4ECF8" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9"
                                 Fill="{Binding StateDotBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11.5"
                                   Margin="6,0,0,0"
                                   Foreground="#FF1B2733"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="7,3.5" Margin="5,0,0,0"
                        BorderBrush="#FFE9E3FB" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF6F2FF" Offset="0" />
                            <GradientStop Color="#FFEDE4FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding LevelBadge}" FontSize="10.5"
                               Foreground="#FF6C5CE0" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
