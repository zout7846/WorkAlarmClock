<Window x:Class="WorkAlarmClock.Views.ScreenshotAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图标注"
        Width="920" Height="720"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B2430"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Grid.Row="0" Background="#FF27313D" CornerRadius="10" Padding="10,8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="RectTool" IsChecked="True" Click="OnToolClick"
                              Style="{StaticResource ToolToggleStyle}" Tag="Rect" ToolTip="矩形">
                    <TextBlock Text="&#x25A1;" FontSize="15" />
                </ToggleButton>
                <ToggleButton x:Name="ArrowTool" Click="OnToolClick"
                              Style="{StaticResource ToolToggleStyle}" Tag="Arrow" ToolTip="箭头">
                    <TextBlock Text="&#x2192;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="PenTool" Click="OnToolClick"
                              Style="{StaticResource ToolToggleStyle}" Tag="Pen" ToolTip="画笔">
                    <TextBlock Text="&#x270E;" FontSize="15" />
                </ToggleButton>
                <ToggleButton x:Name="TextTool" Click="OnToolClick"
                              Style="{StaticResource ToolToggleStyle}" Tag="Text" ToolTip="文字标注">
                    <TextBlock Text="T" FontSize="14" FontWeight="Bold" />
                </ToggleButton>

                <ToggleButton x:Name="MosaicTool" Click="OnToolClick" Style="{StaticResource ToolToggleStyle}" Tag="Mosaic" ToolTip="马赛克：拖动框选区域，可撤销"><TextBlock Text="马赛克" FontSize="12"/></ToggleButton>
                <Border Width="1" Background="#FF3A4655" Margin="10,2" />

                <Button x:Name="ColorRed" Style="{x:Null}" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="红色"
                        Background="#FFFF4D4F" BorderThickness="0" Click="OnColorClick" Tag="#FFFF4D4F" />
                <Button x:Name="ColorYellow" Style="{x:Null}" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="黄色"
                        Background="#FFFFC53D" BorderThickness="0" Click="OnColorClick" Tag="#FFFFC53D" />
                <Button x:Name="ColorBlue" Style="{x:Null}" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="蓝色"
                        Background="#FF3B7DF6" BorderThickness="0" Click="OnColorClick" Tag="#FF3B7DF6" />

                <Border Width="1" Background="#FF3A4655" Margin="10,2" />

                <Button Click="OnUndo" Style="{StaticResource DarkButtonStyle}" MinWidth="34" ToolTip="撤销">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                </Button>
                <Button Click="OnCopy" Style="{StaticResource DarkButtonStyle}" MinWidth="34" ToolTip="复制">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                </Button>
                <Button Click="OnSave" Style="{StaticResource AccentButtonStyle}" MinWidth="70">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="保存" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnClose" Style="{StaticResource DarkButtonStyle}" MinWidth="34" Margin="8,0,0,0" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- 画布 -->
        <Border Grid.Row="1" Margin="0,10,0,0" Background="#FF141B24" CornerRadius="10" ClipToBounds="True">
            <!-- 固定原图坐标，由 Viewbox 统一等比缩放图片与标注。 -->
            <Grid x:Name="CanvasHost">
                <Viewbox Stretch="Uniform">
                <Grid x:Name="ImageHost" ClipToBounds="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      MouseLeftButtonDown="OnCanvasMouseDown"
                      MouseMove="OnCanvasMouseMove"
                      MouseLeftButtonUp="OnCanvasMouseUp">
                    <Image x:Name="CanvasImage" Stretch="Uniform" />
                    <Canvas x:Name="ShapeLayer" Background="Transparent" />
                </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#FFB9C4D2" FontSize="11.5" Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   Text="矩形/箭头/画笔可直接在图上拖动绘制；保存后写入截图目录。" />
    </Grid>
</Window>
