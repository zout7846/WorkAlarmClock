<Window xmlns:ui="clr-namespace:WorkAlarmClock.Views" x:Class="WorkAlarmClock.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒计时"
        Width="420" Height="444"
        MinWidth="360" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="#F2F7FD"
        FontFamily="Microsoft YaHei UI">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ui:WorkspaceFrame/><Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="倒计时" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,14,0,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="{Binding TimeText}" FontSize="46" FontWeight="Bold"
                           FontFamily="Consolas" Foreground="{StaticResource BrushAccentDeep}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 预设 -->
        <UniformGrid Grid.Row="2" Columns="6" Margin="0,12,0,0">
            <Button Content="5" Command="{Binding PresetCommand}" CommandParameter="5"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" Margin="0,0,6,0" />
            <Button Content="10" Command="{Binding PresetCommand}" CommandParameter="10"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" Margin="0,0,6,0" />
            <Button Content="15" Command="{Binding PresetCommand}" CommandParameter="15"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" Margin="0,0,6,0" />
            <Button Content="25" Command="{Binding PresetCommand}" CommandParameter="25"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" Margin="0,0,6,0" />
            <Button Content="30" Command="{Binding PresetCommand}" CommandParameter="30"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" Margin="0,0,6,0" />
            <Button Content="45" Command="{Binding PresetCommand}" CommandParameter="45"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="7,7" />
        </UniformGrid>

        <!-- 自定义 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="自定义分钟数…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MinutesText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                    MinWidth="88" Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                        <Setter Property="Background" Value="{StaticResource BrushAccentGradient}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="#FFEF5A5A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="关闭" Command="{Binding CloseCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="66" Margin="10,0,0,0" />
        </Grid>
    </Grid>

 </ScrollViewer></Grid></Grid>
</Window>
