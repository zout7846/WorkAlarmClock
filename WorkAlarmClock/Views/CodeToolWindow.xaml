<Window xmlns:ui="clr-namespace:WorkAlarmClock.Views" x:Class="WorkAlarmClock.Views.CodeToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="二维码 / 条码" Width="760" Height="784" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F3F7FC" FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ui:WorkspaceFrame/><Grid Grid.Row="1">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="二维码与条码" FontSize="22" FontWeight="SemiBold" Foreground="#23476E"/>
            <TextBlock Text="生成、识别、复制或导出图片" Foreground="#66758A" Margin="0,5,0,16"/>
            <Border Background="White" BorderBrush="#DDEAF7" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="生成" FontSize="16" FontWeight="SemiBold" Foreground="#23476E"/>
                    <DockPanel Margin="0,12,0,8">
                        <TextBlock Text="格式" VerticalAlignment="Center" Foreground="#66758A" Margin="0,0,10,0"/>
                        <ComboBox x:Name="FormatPicker" Width="180" SelectedIndex="0">
                            <ComboBoxItem Content="二维码 (QR)" Tag="QR_CODE"/>
                            <ComboBoxItem Content="Code 128" Tag="CODE_128"/>
                            <ComboBoxItem Content="EAN-13" Tag="EAN_13"/>
                        </ComboBox>
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="宽度" VerticalAlignment="Center" Foreground="#66758A" Margin="0,0,8,0"/>
                        <TextBox x:Name="WidthInput" Text="320" Width="80" MinHeight="32" VerticalContentAlignment="Center"/>
                        <TextBlock Text="高度" VerticalAlignment="Center" Foreground="#66758A" Margin="16,0,8,0"/>
                        <TextBox x:Name="HeightInput" Text="320" Width="80" MinHeight="32" VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="UnitPicker" Width="75" SelectedIndex="0" Margin="8,0,0,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="px"/><ComboBoxItem Content="mm"/><ComboBoxItem Content="cm"/>
                        </ComboBox>
                        <Button Content="保存尺寸" Click="SaveSize_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBox x:Name="InputText" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" ToolTip="输入要编码的文字或号码"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="生成" Click="Generate_Click" Style="{StaticResource AccentButtonStyle}" ToolTip="生成或更新预览 (Ctrl+Enter)"/>
                        <Button Content="粘贴文本" Click="PasteText_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="复制图片" Click="CopyImage_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="导出 PNG" Click="Export_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="二维码需保持正方形；条码可单独设置宽和高。" Foreground="#66758A" FontSize="12" Margin="0,2,0,0"/>
                    <Border Background="#F7FAFE" BorderBrush="#E5EDF6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" MinHeight="230">
                        <Image x:Name="CodePreview" Stretch="Uniform" MaxHeight="320"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#DDEAF7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="识别" FontSize="16" FontWeight="SemiBold" Foreground="#23476E"/>
                    <TextBlock Text="从图片文件识别二维码或常见条码，也可粘贴剪贴板中的图片。" Foreground="#66758A" Margin="0,5,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="选择图片识别" Click="ChooseImage_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="粘贴图片识别" Click="DecodeClipboard_Click" Style="{StaticResource PrimaryButtonStyle}" ToolTip="从剪贴板图片格式读取二维码或条码"/>
                        <Button Content="复制识别结果" Click="CopyText_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </WrapPanel>
                    <TextBox x:Name="DecodedText" Margin="0,10,0,0" MinHeight="72" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    <TextBlock x:Name="StatusText" Foreground="#66758A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

 </Grid></Grid>
</Window>
