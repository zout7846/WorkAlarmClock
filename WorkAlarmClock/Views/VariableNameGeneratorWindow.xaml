<Window xmlns:ui="clr-namespace:WorkAlarmClock.Views" x:Class="WorkAlarmClock.Views.VariableNameGeneratorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="变量名生成器" Width="920" Height="844" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F2F7FD" FontFamily="Microsoft YaHei UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UtilityTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ui:WorkspaceFrame/><Grid Grid.Row="1">

 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="变量名生成器" FontSize="26" FontWeight="SemiBold" Foreground="#203F64"/><TextBlock Text="从一句描述，到清晰的代码命名" Style="{StaticResource ToolHint}" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E2EEFC" CornerRadius="8" Padding="12,8"><TextBlock Text="中英互译 / 5 种命名" Foreground="#387AC2"/></Border></Grid>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource ToolCard}"><StackPanel><DockPanel LastChildFill="False" Margin="0,0,0,10"><TextBlock Text="01  输入描述" Style="{StaticResource ToolLabel}" VerticalAlignment="Center" Margin="0"/><Button Content="粘贴" DockPanel.Dock="Right" Click="Paste_Click"/></DockPanel><TextBox x:Name="InputText" Height="150" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="16" TextChanged="Input_Changed"/><TextBlock Text="例如：用户登录时间 / userLoginTime" Style="{StaticResource ToolHint}" Margin="0,10,0,0"/></StackPanel></Border>
 <Border Grid.Column="2" Style="{StaticResource ToolCard}"><StackPanel><DockPanel LastChildFill="False" Margin="0,0,0,10"><TextBlock Text="02  翻译结果" Style="{StaticResource ToolLabel}" VerticalAlignment="Center" Margin="0"/><Button Content="复制译文" DockPanel.Dock="Right" Click="CopyTranslation_Click"/></DockPanel><TextBox x:Name="TranslationText" Height="150" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="16"/><TextBlock Text="可编辑译文，再点击生成变量名" Style="{StaticResource ToolHint}" Margin="0,10,0,0"/></StackPanel></Border>
 </Grid>
 <WrapPanel x:Name="Actions" Margin="0,14,0,14"><Button Content="中文 → 英文" Click="TranslateToEnglish_Click"/><Button Content="英文 → 中文" Click="TranslateToChinese_Click" Margin="8,0,0,0"/><Button Content="生成变量名" Click="Generate_Click" Style="{StaticResource ToolAccentButton}" Margin="8,0,0,0" Padding="20,9"/></WrapPanel>
 <Border Style="{StaticResource ToolCard}"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="03  命名候选" Style="{StaticResource ToolLabel}"/><Button DockPanel.Dock="Right" Content="复制全部" Click="CopyAll_Click"/></DockPanel>
 <ListBox x:Name="NamesList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Format}" Foreground="#6D829A" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" MinHeight="38" Padding="10,6" Margin="0,0,12,0"/><Button Grid.Column="2" Content="复制" Tag="{Binding Value}" Click="CopyOne_Click"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
 </StackPanel></Border></StackPanel></ScrollViewer>
 <Border Grid.Row="2" Background="#E8F1FC" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#387AC2" TextWrapping="Wrap" Text="输入内容后选择翻译方向；在线翻译使用 MyMemory，失败后尝试备用服务。"/></Border>
 </Grid>
 </Grid></Grid>
</Window>