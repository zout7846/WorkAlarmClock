<Window x:Class="WorkAlarmClock.Views.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天气"
        Width="480" Height="440"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPanelGradient}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="天气" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" />

        <!-- 当前天气 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding CityText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding TemperatureText}" FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentDeep}" />
                        <TextBlock Text="{Binding DescriptionText}" FontSize="13" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="10,0,0,8" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="52"
                           Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- 预报标题 -->
        <TextBlock Grid.Row="2" Text="未来 3 天" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,8" />

        <!-- 三日预报 -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Width="128" Margin="0,0,10,0">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WeekdayText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RangeText}" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="自动定位" Command="{Binding LocateCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="80" />
            <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="66" />
            <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="66" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
