<Window xmlns:ui="clr-namespace:WorkAlarmClock.Views" x:Class="WorkAlarmClock.Views.WeatherWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="天气" Width="740" Height="824" MinWidth="560" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ui:WorkspaceFrame/><Grid Grid.Row="1">

 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <StackPanel><TextBlock Text="天气概览" FontSize="24" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="此刻天气与未来出行参考" Foreground="#66758C" Margin="0,6,0,0"/></StackPanel>
   <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
    <Button Content="重新定位" Command="{Binding LocateCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButtonStyle}"/>
    <Button Content="刷新天气" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource AccentButtonStyle}"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="天气地区" FontSize="15" FontWeight="SemiBold" Foreground="#172B4D"/>
      <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding CityOptions}" SelectedItem="{Binding SelectedCity}" DisplayMemberPath="Name"
                 IsEditable="True" IsReadOnly="False" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                 IsEnabled="{Binding IsIdle}" MinHeight="34" VerticalContentAlignment="Center" ToolTip="输入城市名快速选择"/>
       <Button Grid.Column="1" Content="应用地区" Command="{Binding ApplyCityCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding LocationText}" Foreground="#66758C" TextWrapping="Wrap"/>
      <TextBlock Text="手动选择后将固定该城市；点击重新定位可恢复 IP 自动定位。" Foreground="#66758C" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border CornerRadius="20" Padding="26" Margin="0,0,0,20">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#214F99"/><GradientStop Color="#398FC1" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding CityText}" FontSize="21" Foreground="White" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding TemperatureText}" FontSize="64" Foreground="White" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding DescriptionText}" FontSize="17" Foreground="White"/>
       <TextBlock Text="{Binding UpdatedText}" Foreground="#D7E9FF" Margin="0,14,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="76" Foreground="#E6F4FF" VerticalAlignment="Center" Margin="16"/>
     </Grid>
    </Border>
    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
     <StackPanel>
      <TextBlock Text="逐小时降水趋势" Foreground="#172B4D" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="未来 24 小时 · 降水概率（0–100%）" TextWrapping="Wrap" Foreground="#66758C" Margin="0,6,0,14"/>
      <ui:TrendChart Values="{Binding RainTrend}" Labels="{Binding HourLabels}" Unit="%" Maximum="100" Height="190" Margin="0,0,0,12"/>
      <TextBlock Text="暂无逐小时预报，请刷新后重试" Foreground="#66758C" Margin="0,0,0,12">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Hours.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding Hours}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Width="64" Margin="0,0,5,10">
          <TextBlock Text="{Binding Temperature}" HorizontalAlignment="Center" FontSize="15" Foreground="#172B4D"/>
          <Grid Height="110" Margin="0,8"><Border Background="#F0F5FC" Width="26" CornerRadius="5"/><Border Background="#458CE4" Width="26" CornerRadius="5" Height="{Binding BarHeight}" VerticalAlignment="Bottom"/></Grid>
          <TextBlock Text="{Binding Probability}" HorizontalAlignment="Center" Foreground="#2765AF" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Rain}" HorizontalAlignment="Center" Foreground="#66758C" FontSize="11" Margin="0,4"/>
          <TextBlock Text="{Binding Time}" HorizontalAlignment="Center" Foreground="#66758C"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="降水量单位 mm，包含雨雪；— 表示暂无数据" Foreground="#66758C" FontSize="11"/>
     </StackPanel>
    </Border>
    <TextBlock Text="未来 3 天" FontSize="17" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding Days}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="White" CornerRadius="14" Padding="14" Margin="0,0,8,0"><StackPanel HorizontalAlignment="Center">
       <TextBlock Text="{Binding WeekdayText}" HorizontalAlignment="Center" Foreground="#172B4D"/>
       <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#3983C6" HorizontalAlignment="Center" Margin="0,12"/>
       <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Center" FontSize="16" Foreground="#172B4D"/>
       <TextBlock Text="{Binding Description}" HorizontalAlignment="Center" Foreground="#66758C" Margin="0,6,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock Text="{Binding StatusText}" Foreground="#2765AF" TextWrapping="Wrap"/>
   <TextBlock Text="IP 定位为网络出口的近似位置，地区不符时可在设置中手动选择城市。" Foreground="#66758C" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>

 </Grid></Grid>
</Window>
