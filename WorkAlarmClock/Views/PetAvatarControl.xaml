<UserControl x:Class="WorkAlarmClock.Views.PetAvatarControl"
             x:Name="AvatarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="215"
             Background="Transparent">
    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Source="/Assets/pet.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.95"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BreathScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="JumpTranslate" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
