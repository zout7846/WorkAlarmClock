<Window x:Class="WorkAlarmClock.Views.StrongReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打卡提醒"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        Closing="OnWindowClosing">
    <Grid>
        <!-- 全屏半透明遮罩 -->
        <Border Background="#C8101826" />

        <!-- 居中警示卡片 -->
        <Border x:Name="AlertBorder"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="470" Padding="36,32"
                CornerRadius="20"
                BorderBrush="#FFEF5A5A" BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFCFC" Offset="0" />
                    <GradientStop Color="#FFFFF4F4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.36" Color="#FF7A1E1E" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Background="#FFFFE8E8" CornerRadius="14" Padding="14,6" HorizontalAlignment="Center">
                    <TextBlock Text="⏰ 该打卡了！" FontSize="32" FontWeight="Bold"
                               Foreground="#FFE23B3B" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="下班时间快到了，请立即打卡！"
                           FontSize="15" Margin="0,12,0,0"
                           Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <StackPanel Orientation="Vertical" Margin="0,0,28,0">
                        <TextBlock Text="当前时间" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding NowText}" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,28,0">
                        <TextBlock Text="今日工作" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding WorkDurationText}" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="日报状态" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding ReportStatusText}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding CountdownText}" FontSize="14" Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" />

                <Button Content="已打卡，确认" FontSize="17" FontWeight="SemiBold"
                        Command="{Binding ConfirmCommand}"
                        Padding="28,10" Margin="0,24,0,0"
                        HorizontalAlignment="Center" Cursor="Hand" />

                <Button x:Name="IgnoreButton" Content="忽略（明天记得早点打卡）" FontSize="12"
                        Command="{Binding IgnoreCommand}"
                        Padding="14,4" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllowIgnoreVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="未确认时将按设置间隔重复提醒"
                           FontSize="11" Margin="0,14,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
