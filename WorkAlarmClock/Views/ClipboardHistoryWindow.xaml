<Window x:Class="WorkAlarmClock.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="680" Height="520"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPanelGradient}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="剪贴板历史" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextPrimary}" />
            <Grid Grid.Column="1" Margin="18,0,12,0" MaxWidth="280" HorizontalAlignment="Left">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                <TextBlock Text="搜索…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="60" Height="30" />
                <Button Content="清空" Command="{Binding ClearCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="60" Height="30" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="8">
            <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="#FFF8FAFE" BorderBrush="#FFEDF2F9"
                                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CapturedAt, StringFormat=HH:mm:ss}"
                                                       FontSize="11" Foreground="{StaticResource BrushTextTertiary}"
                                                       VerticalAlignment="Top" Margin="0,2,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                                       TextWrapping="Wrap" MaxHeight="40"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="复制" Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="26" MinWidth="48" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="删除" Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="26" MinWidth="48"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#FFF2F7FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
            <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="72" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
