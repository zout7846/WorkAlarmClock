<Window x:Class="WorkAlarmClock.Views.ReportHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史日报"
        Width="800" Height="620"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPanelGradient}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="历史日报" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextPrimary}" />

            <Grid Grid.Column="1" Margin="18,0,12,0" MaxWidth="300" HorizontalAlignment="Left">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                <TextBlock Text="搜索日期或内容…" IsHitTestVisible="False" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource BrushTextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="66" Height="30" />
                <Button Content="生成本周周报" Command="{Binding GenerateWeeklyCommand}"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="112" Height="30" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- 列表 + 预览 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="#FFF8FAFE" BorderBrush="#FFEDF2F9"
                                                BorderThickness="1" CornerRadius="10" Padding="11,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextPrimary}" />
                                                    <TextBlock Text="{Binding WeekText}" FontSize="11"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushTextTertiary}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#FFF2F7FF" />
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource BrushBorderStrong}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource BrushAccentLight}" />
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource BrushAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="12">
                <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12.5"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled" />
            </Border>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="打开文件" Command="{Binding OpenFileCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="打开目录" Command="{Binding OpenFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
