<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="ToolAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="38"/></Style>
 <Style x:Key="ToolCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#DCE8F5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
 <Style x:Key="ToolLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#23476E"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="ToolHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#6D829A"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
</ResourceDictionary>
