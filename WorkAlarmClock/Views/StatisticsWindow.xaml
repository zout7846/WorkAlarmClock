<Window xmlns:ui="clr-namespace:WorkAlarmClock.Views" x:Class="WorkAlarmClock.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作统计"
        Width="660" Height="704"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F2F7FD"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ui:WorkspaceFrame/><Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">


    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 区间切换 -->
        <StackPanel Grid.Row="0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="工作统计" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock Text="{Binding RangeTitle}" FontSize="12" Margin="10,4,0,0"
                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Content="近 7 天" Command="{Binding RangeCommand}" CommandParameter="7"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="72" />
                <Button Content="近 14 天" Command="{Binding RangeCommand}" CommandParameter="14"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="76" />
                <Button Content="近 30 天" Command="{Binding RangeCommand}" CommandParameter="30"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="76" Margin="0" />
            </WrapPanel>
        </StackPanel>

        <!-- 汇总三数字 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="区间总工时" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding TotalWorkText}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="工作日日均" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding AverageWorkText}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStateWorking}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="最高的一天" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding BestDayText}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStateLunch}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2">
        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
          <StackPanel><TextBlock Text="工时趋势" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="蓝色：工作 · 绿色：休息 · 单位：小时" Style="{StaticResource HintTextStyle}"/>
            <ui:TrendChart Values="{Binding WorkTrend}" SecondaryValues="{Binding RestTrend}" Labels="{Binding TrendDates}" Unit="h" Height="180"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
          <StackPanel><TextBlock Text="记录时间分布" Style="{StaticResource SectionTitleStyle}"/><ui:DonutChart Values="{Binding TimeShare}" Labels="{Binding TimeShareLabels}" Unit="h" Height="150"/></StackPanel>
        </Border>
        <!-- 柱状图 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="每日工时" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource BrushStateWorking}" VerticalAlignment="Center" />
                        <TextBlock Text="工作" Style="{StaticResource CaptionStyle}" Margin="5,0,12,0" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Fill="{StaticResource BrushStateResting}" VerticalAlignment="Center" />
                        <TextBlock Text="休息" Style="{StaticResource CaptionStyle}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="{Binding BarWidth}" Margin="0,0,7,0" ToolTip="{Binding Tooltip}">
                                    <Grid Height="132" VerticalAlignment="Bottom">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border Height="{Binding RestHeight}" Background="{StaticResource BrushStateResting}"
                                                    CornerRadius="4,4,0,0" Margin="0,0,0,1" />
                                            <Border Height="{Binding WorkHeight}" Background="{StaticResource BrushStateWorking}"
                                                    CornerRadius="4,4,2,2" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DateText}" FontSize="10.5" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" Foreground="{StaticResource BrushTextTertiary}"
                                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="还没有可统计的工时数据，先点「开始工作」记录一段吧。"
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        </StackPanel>
        <!-- 今日时间轴 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="今天的时间轴" Style="{StaticResource SectionTitleStyle}" />
                <Viewbox Stretch="Fill" Height="46" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="560" Height="40" Background="#FFF3F6FB" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="3" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="34" Background="{Binding Fill}"
                                        CornerRadius="4" Margin="0,0,1,0" ToolTip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <ItemsControl ItemsSource="{Binding Legend}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="9" Height="9" Fill="{Binding Fill}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionStyle}"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="提示：色块从左到右是今天的真实时间顺序，鼠标悬停可看具体时段。"
                           Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="82" />
            <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="82" Margin="0" />
        </StackPanel>
    </Grid>

 </ScrollViewer></Grid></Grid>
</Window>
