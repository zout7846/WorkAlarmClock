<Window x:Class="WorkAlarmClock.MainWindow" x:Name="MainRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:WorkAlarmClock.Views"
 Title="WorkAlarmClock 工作台" Width="1060" Height="740" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F2F7FD" FontFamily="Microsoft YaHei UI" Closing="OnWindowClosing">
 <Window.Resources>
  <Style x:Key="NavigationItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,4"/><Setter Property="Foreground" Value="#405C7B"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#286FC4"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#DDEEFF"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F8FBFF" BorderBrush="#DDEAF7" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,18,12,14">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18"><Border Background="#DCEEFF" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#387AC2" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="工作日记" FontSize="22" FontWeight="Bold" Foreground="#23476E" Margin="0,14,0,4"/><TextBlock Text="WORK ALARM CLOCK" FontSize="10" Foreground="#7D96AF"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Button Content="显示 / 隐藏桌宠" Command="{Binding TogglePetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/><TextBlock Text="让工作有序，让时间清晰" Foreground="#8AA0B8" FontSize="11" Margin="8,20,0,0"/></StackPanel>
    <ListBox SelectedIndex="{Binding SelectedIndex, ElementName=WorkspaceTabs, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}"><ListBoxItem Content="工作概览"/><ListBoxItem Content="今日事项"/><ListBoxItem Content="效率工具"/><ListBoxItem Content="工作汇报"/><ListBoxItem Content="设置"/></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#DDEAF7" BorderThickness="0,0,0,1" Padding="20,12"><DockPanel><Button DockPanel.Dock="Right" Content="效率工具 ↗" Click="OpenTools" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0"/><TextBlock Text="{Binding SelectedItem.Header, ElementName=WorkspaceTabs}" FontSize="18" FontWeight="SemiBold" Foreground="#23476E"/><Border Background="#EDF6FF" CornerRadius="10" Padding="12,4" HorizontalAlignment="Right"><TextBlock Text="{Binding StateText}" Foreground="#387AC2" FontSize="12"/></Border></DockPanel></Border>
   <DockPanel Grid.Row="1"><views:NotificationBar DockPanel.Dock="Top" Margin="18,8,18,0"/><TabControl x:Name="WorkspaceTabs" SelectionChanged="OnPageChanged" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="14,12" Margin="4,6,4,4"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/></ControlTemplate></TabControl.Template>
<TabItem Header="工作概览"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>        <!-- ============ 顶部渐变头卡：状态 + 时钟 + 快捷图标 ============ -->
        <Border Grid.Row="0" CornerRadius="16" Background="#E2F0FF" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <!-- 状态胶囊 -->
                    <Border Background="#33FFFFFF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFD6E2F2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Working">
                                                <Setter Property="Fill" Value="#FF7BF1A8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Resting">
                                                <Setter Property="Fill" Value="#FFFFD873" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="OffWork">
                                                <Setter Property="Fill" Value="#FFCBD6E4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StateText}" Foreground="#23476E" FontSize="12"
                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="已结束当天" Foreground="#527597" FontSize="10.5" Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ManualEnded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding NowText}" Foreground="#23476E" FontSize="34" FontWeight="Bold"
                               Margin="0,8,0,0" FontFamily="Segoe UI Semibold" />
                    <TextBlock Text="专注当下，记录每一份进展" Foreground="#527597" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 快捷图标 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE81C;"
                            Foreground="#23476E" ToolTip="历史日报"
                            Command="{Binding OpenHistoryCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE722;"
                            Foreground="#23476E" ToolTip="区域截图（Ctrl+Alt+A）"
                            Command="{Binding ScreenshotCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE9D9;"
                            Foreground="#23476E" ToolTip="工作统计"
                            Command="{Binding OpenStatisticsCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;"
                            Foreground="#23476E" ToolTip="设置"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="10,9" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="工作" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding WorkDurationText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStateWorking}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="10,9" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="休息" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding RestDurationText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStateResting}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="10,9" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="午休" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding LunchDurationText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushStateLunch}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="10,9">
                <StackPanel>
                    <TextBlock Text="本周" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding WeekWorkText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 操作行 ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="开始工作" Command="{Binding StartWorkCommand}"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="104" />
            <Button Content="开始休息" Command="{Binding StartRestCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" />
            <Button Content="结束当天" Command="{Binding EndDayCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Margin="0" />
        </StackPanel>

        <!-- ============ 番茄钟 ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF8A80" Offset="0" />
                                <GradientStop Color="#FFF0564D" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FocusTimeText}" FontSize="21" FontWeight="Bold"
                                   FontFamily="Segoe UI Semibold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}">
                            <Run Text="{Binding FocusPhaseText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding FocusRoundsText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="跳过" Command="{Binding FocusSkipCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="60" Margin="0,0,6,0" />
                    <Button Content="{Binding FocusButtonText}" Command="{Binding FocusToggleCommand}"
                            MinWidth="88" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource BrushAccentGradient}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocusRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFEF5A5A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 本周统计（可折叠） ============ -->
        <Border Grid.Row="5" Margin="0,12,0,0" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="本周统计（按工作日累计）" Style="{StaticResource SectionTitleStyle}" />
                <UniformGrid Columns="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="工作" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WeekWorkText}" Style="{StaticResource PillValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="休息" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WeekRestText}" Style="{StaticResource PillValueStyle}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

<Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14"><StackPanel><TextBlock Text="常用工具" FontSize="15" FontWeight="SemiBold" Foreground="#23476E"/><WrapPanel Margin="0,10,0,0"><Button Content="截图 / 马赛克" Command="{Binding ScreenshotCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="计算器" Click="OpenTools" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="天气" Command="{Binding OpenWeatherCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="倒计时" Command="{Binding OpenCountdownCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="记录事项" Click="OpenTasks" Style="{StaticResource AccentButtonStyle}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="今日事项"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>        <!-- ============ 今日事项 ============ -->
        <Grid Grid.Row="0" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,8">
                <TextBlock Text="今日事项" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedTagFilter}"
                              Width="96" Height="26" FontSize="11.5" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center">
                        <Run Text="{Binding Tasks.Count, Mode=OneWay}" />
                        <Run Text=" 条" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- 空列表占位 -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#FFF7FAFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="14" Padding="18,14" Margin="12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" />
                        <TextBlock Text="今天还没有记录" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,6,0,2" />
                        <TextBlock Text="在下方输入「我在做什么」，回车即可记一条"
                                   Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding TasksView}" Style="{StaticResource TaskListStyle}"
                         ItemContainerStyle="{StaticResource TaskItemStyle}"
                         HorizontalContentAlignment="Stretch" MinHeight="80">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BrushAccentLight}" CornerRadius="7" Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}"
                                               FontSize="11" Foreground="{StaticResource BrushAccentDeep}" />
                                </Border>
                                <Border Grid.Column="1" CornerRadius="7" Padding="7,2" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Background="#FFF0F6EC">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="#FF4B7A3F" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="9,0,8,0" Foreground="{StaticResource BrushTextPrimary}" />
                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                        Content="&#xE74D;" Width="26" Height="26" FontSize="12"
                                        ToolTip="删除这条事项"
                                        Command="{Binding DataContext.RemoveTaskCommand, ElementName=MainRoot}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ============ 输入行 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding TagOptions}" SelectedItem="{Binding SelectedTag}"
                          DisplayMemberPath="Text" Width="78" Margin="0,0,8,0"
                          VerticalAlignment="Center" FontSize="11.5" />
                <TextBox Grid.Column="1" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalContentAlignment="Center"
                         ToolTip="输入「我在做什么」，回车即可添加">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Column="1" Text="记录一下你在做什么，回车添加…" IsHitTestVisible="False"
                           Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource BrushTextTertiary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InputText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Content="添加" Command="{Binding AddTaskCommand}"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="62" Margin="8,0,0,0" />
            </Grid>
        </Border>

</Grid></TabItem>
<TabItem Header="效率工具"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="效率工具" FontSize="24" FontWeight="SemiBold" Foreground="#23476E"/><TextBlock Text="天气、倒计时、剪贴板与网络状态，随时取用。" Foreground="#66758A" Margin="0,8,0,20"/>        <!-- ============ 工具磁贴行 ============ -->
        <UniformGrid Grid.Row="4" Columns="2" Margin="0,12,0,0">
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenWeatherCommand}" Margin="0,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WeatherTileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeatherTileText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding WeatherTileSub}" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenCountdownCommand}" Margin="0,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource BrushStateLunch}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountdownTileText}" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="倒计时" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenClipboardCommand}" Margin="0,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="#FF6C5CE0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClipboardTileText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="剪贴板" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenSpeedTestCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{Binding NetworkTileColor}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NetworkTileText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding NetworkTileSub}" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenCalculatorCommand}" Margin="0,0,10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#247DB5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="计算器" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/><TextBlock Text="四则运算" Style="{StaticResource CaptionStyle}"/></StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenRadixConverterCommand}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#C06A31" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="进制转换" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/><TextBlock Text="二 / 八 / 十 / 十六进制" Style="{StaticResource CaptionStyle}"/></StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenCodeToolCommand}" Margin="0,0,10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D34F64" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="二维码 / 条码" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/><TextBlock Text="生成、识别与导出" Style="{StaticResource CaptionStyle}"/></StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenVariableNameGeneratorCommand}" Margin="0,0,10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#2A9D8F" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="变量名生成器" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/><TextBlock Text="中英翻译 · 命名格式" Style="{StaticResource CaptionStyle}"/></StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding OpenImageConverterCommand}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#C06A31" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="图片转换器" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/><TextBlock Text="PNG / JPG / 多尺寸 ICO" Style="{StaticResource CaptionStyle}"/></StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

<WrapPanel Margin="0,20,0,0"><Button Content="区域截图" Command="{Binding ScreenshotCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="显示 / 隐藏桌宠" Command="{Binding TogglePetCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="工作汇报"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="工作汇报" FontSize="24" FontWeight="SemiBold" Foreground="#23476E"/><TextBlock Text="将今日事项整理为汇报，回顾工作进展。" Foreground="#66758A" Margin="0,8,0,24"/><Border Style="{StaticResource CardStyle}" Padding="24"><StackPanel><TextBlock Text="今天的每一步，都值得记录" FontSize="20" Foreground="#23476E"/><TextBlock Text="生成汇报前，可先在今日事项中补充记录。" Foreground="#66758A" Margin="0,10,0,20"/><WrapPanel><Button Content="生成工作汇报" Command="{Binding GenerateReportCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="日报预览" Command="{Binding OpenPreviewCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="历史日报" Command="{Binding OpenHistoryCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="工作统计" Command="{Binding OpenStatisticsCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
